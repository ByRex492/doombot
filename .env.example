# Plantilla de configuracion local. Copiar a .env y ajustar.
#
#     cp .env.example .env        (bash)
#     Copy-Item .env.example .env (PowerShell)
#
# .env esta en .gitignore y NO se versiona: es lo unico del proyecto que
# depende del equipo. Si algo tiene que cambiar entre el sobremesa y el
# portatil, su sitio es este fichero, no el codigo.

# --- Ollama ----------------------------------------------------------------
# Por defecto el Ollama local. Para que el portatil use la GPU del sobremesa:
#   DOOMBOT_OLLAMA_HOST=http://192.168.1.XX:11434
# (requiere OLLAMA_HOST=0.0.0.0 en el sobremesa y ambos en la misma red)
DOOMBOT_OLLAMA_HOST=http://127.0.0.1:11434

# --- Motor de lenguaje -------------------------------------------------------
# Que TextGenerator construye el orquestador: "ollama" (local, D-009) o
# "anthropic" (Claude, en la nube) o "varios" (los de DOOMBOT_MODELOS, en
# cadena, D-034). Ollama sigue siendo el que corre por
# defecto: menor latencia y funciona sin conexion. "anthropic" pesa mas la
# calidad de razonamiento, a costa de mandar la conversacion fuera del equipo.
DOOMBOT_LLM_BACKEND=ollama

# Solo hace falta si DOOMBOT_LLM_BACKEND=anthropic. Se crea en:
#   https://console.anthropic.com/settings/keys
DOOMBOT_ANTHROPIC_API_KEY=
DOOMBOT_ANTHROPIC_MODEL=claude-sonnet-5

# --- Perfil de hardware ----------------------------------------------------
# Vacio = se detecta solo segun la VRAM disponible (ver profiles.toml).
# Rellenar solo para forzar uno concreto en pruebas.
DOOMBOT_PROFILE=

# --- Datos -----------------------------------------------------------------
# Vacio = carpeta de datos del usuario que da el sistema operativo.
# Rellenar solo si quieres la memoria en otro sitio.
DOOMBOT_DATA_DIR=

# --- Microfono -------------------------------------------------------------
# Vacio = el microfono predeterminado del sistema, que no siempre es el que
# uno espera (en el sobremesa es el virtual del Oculus).
# Se pone un FRAGMENTO DEL NOMBRE, no un indice: los indices cambian al
# enchufar o quitar un USB. Para ver los disponibles:
#   python -m doombot micro
#   DOOMBOT_AUDIO_INPUT=A50
DOOMBOT_AUDIO_INPUT=

# --- Registro --------------------------------------------------------------
DOOMBOT_LOG_LEVEL=INFO

# --- Ollama: ajuste del SERVIDOR, no del proyecto --------------------------
# D-010. Con gemma4:12b y qwen3:8b cargados a la vez la VRAM del sobremesa
# llega a 15.349 de 16.311 MiB: no caben dos modelos mas Whisper y el TTS.
# Esto NO se puede fijar desde aqui —es una variable del servicio de Ollama—,
# asi que se define en el sistema:
#
#   setx OLLAMA_MAX_LOADED_MODELS 1
#
# Y despues reiniciar Ollama. `python -m doombot` avisa si no esta puesto.

# --- Agente de acciones ------------------------------------------------------
# Capa de acciones (D-014): delega tareas reales -editar codigo, correr
# comandos- en un `claude -p` no interactivo.
#
# "plan" (por defecto) propone lo que haria SIN ejecutar nada. Es el valor
# seguro para algo disparado por voz: pasar a un modo que ejecuta de verdad
# es una decision que tomas tu, no el codigo.
#   acceptEdits         edita ficheros sin preguntar, pide permiso para el resto
#   bypassPermissions   ejecuta todo sin preguntar (solo en una maquina de confianza)
DOOMBOT_AGENT_PERMISSION_MODE=plan

# Ruta al binario si `claude` no esta en PATH.
DOOMBOT_AGENT_BINARY=claude

# Vacio = sin restriccion de herramientas (dentro de lo que permita el modo
# de arriba). Lista separada por comas, ej: DOOMBOT_AGENT_ALLOWED_TOOLS=Read,Grep,Edit
DOOMBOT_AGENT_ALLOWED_TOOLS=

# --- Varios modelos gratuitos (D-034) ----------------------------------------
# Lista en orden de preferencia, proveedor:modelo. Se usa con
# DOOMBOT_LLM_BACKEND=varios y/o DOOMBOT_AGENT_BRAIN=varios: si el primero
# falla o se queda sin cuota, responde el siguiente. "/contrasta <pregunta>"
# (o "contrasta ..." en el chat) les pregunta a todos y compara.
#
# Mejor de familias distintas (OpenAI, Google, NVIDIA...): si coinciden tres
# modelos entrenados por separado, el dato es mas fiable que el de uno solo.
# Las capas gratuitas cambian a menudo: comprueba los modelos y limites en el
# panel de cada proveedor (estado a 13/10/2026 en D-034).
#
# Proveedores: groq, gemini, openrouter, nvidia, mistral, cerebras, github,
# y ademas ollama (local, sin clave) y anthropic (de pago).
DOOMBOT_MODELOS=groq:openai/gpt-oss-120b,gemini:gemini-3.8-flash,nvidia:nvidia/nemotron-3-super-120b-a12b
# En el sobremesa, el local al final como red de seguridad sin internet:
#   ...,ollama:gemma4:12b

# Una clave por proveedor. Gratuitas, sin tarjeta, se crean en:
#   groq     https://console.groq.com/keys
#   gemini   https://aistudio.google.com/apikey
#   nvidia   https://build.nvidia.com   (programa de desarrolladores)
#   openrouter https://openrouter.ai/keys  (solo 50 peticiones/dia gratis)
# OJO: lo que el agente lee -paginas, ficheros, titulos de ventanas- sale
# hacia estos proveedores. Algunos usan las peticiones gratuitas para mejorar
# sus modelos (Gemini fuera del EEE; Mistral en su plan gratuito).
DOOMBOT_GROQ_API_KEY=
DOOMBOT_GEMINI_API_KEY=
DOOMBOT_NVIDIA_API_KEY=
DOOMBOT_OPENROUTER_API_KEY=

# Antes de algo irreversible, otro modelo de la lista da una segunda opinion
# que se ve junto a la pregunta de confirmacion. "no" para desactivarla.
DOOMBOT_AGENT_REVISOR=si

# --- Agente local: python -m doombot agente ----------------------------------
# D-033. Bucle propio que abre aplicaciones, maneja un navegador propio, lee y
# escribe ficheros y ejecuta comandos. Pregunta antes de lo irreversible.
#
# Quien decide que hacer: ollama, anthropic o varios (la lista de arriba).
# Vacio = el de DOOMBOT_LLM_BACKEND.
# Elegir herramientas pide mas modelo que conversar: con 3B se equivoca a
# menudo (capa4-investigacion.md). En un equipo sin GPU, anthropic.
DOOMBOT_AGENT_BRAIN=

# Modelo de Ollama para el agente, si no quieres el del perfil. Tiene que
# soportar herramientas (tools): qwen3, llama3.1+, gemma4, mistral-nemo...
DOOMBOT_AGENT_MODEL=

# --- n8n: "activa el flujo <nombre>" ----------------------------------------
# D-030. D.O.O.M dispara workflows de n8n por su webhook; nunca al reves -n8n
# no puede iniciar nada en D.O.O.M-. Un webhook no tiene modo "plan": ejecuta
# en cuanto llega la peticion, asi que la unica salvaguarda es esta lista
# blanca. Un nombre que no este aqui no dispara nada, solo avisa.
#
# Vacio = n8n no configurado; la orden avisa en vez de fallar al arrancar.
DOOMBOT_N8N_BASE_URL=

# nombre_hablado:ruta/del/webhook, separados por comas. El nombre se compara
# normalizado (sin tildes, mayusculas ni puntuacion), igual que el resto de
# ordenes de voz.
#   DOOMBOT_N8N_WORKFLOWS=riego del jardin:webhook/riego-jardin,backup:webhook/backup-diario
DOOMBOT_N8N_WORKFLOWS=
