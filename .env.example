# Plantilla de configuracion local. Copiar a .env y ajustar.
#
#     cp .env.example .env        (bash)
#     Copy-Item .env.example .env (PowerShell)
#
# .env esta en .gitignore y NO se versiona: es lo unico del proyecto que
# depende del equipo. Si algo tiene que cambiar entre el sobremesa y el
# portatil, su sitio es este fichero, no el codigo.

# --- Ollama ----------------------------------------------------------------
# Por defecto el Ollama local. Para que el portatil use la GPU del sobremesa:
#   DOOMBOT_OLLAMA_HOST=http://192.168.1.XX:11434
# (requiere OLLAMA_HOST=0.0.0.0 en el sobremesa y ambos en la misma red)
DOOMBOT_OLLAMA_HOST=http://127.0.0.1:11434

# --- Perfil de hardware ----------------------------------------------------
# Vacio = se detecta solo segun la VRAM disponible (ver profiles.toml).
# Rellenar solo para forzar uno concreto en pruebas.
DOOMBOT_PROFILE=

# --- Datos -----------------------------------------------------------------
# Vacio = carpeta de datos del usuario que da el sistema operativo.
# Rellenar solo si quieres la memoria en otro sitio.
DOOMBOT_DATA_DIR=

# --- Microfono -------------------------------------------------------------
# Vacio = el microfono predeterminado del sistema, que no siempre es el que
# uno espera (en el sobremesa es el virtual del Oculus).
# Se pone un FRAGMENTO DEL NOMBRE, no un indice: los indices cambian al
# enchufar o quitar un USB. Para ver los disponibles:
#   python -m doombot micro
#   DOOMBOT_AUDIO_INPUT=A50
DOOMBOT_AUDIO_INPUT=

# --- Registro --------------------------------------------------------------
DOOMBOT_LOG_LEVEL=INFO

# --- Ollama: ajuste del SERVIDOR, no del proyecto --------------------------
# D-010. Con gemma4:12b y qwen3:8b cargados a la vez la VRAM del sobremesa
# llega a 15.349 de 16.311 MiB: no caben dos modelos mas Whisper y el TTS.
# Esto NO se puede fijar desde aqui —es una variable del servicio de Ollama—,
# asi que se define en el sistema:
#
#   setx OLLAMA_MAX_LOADED_MODELS 1
#
# Y despues reiniciar Ollama. `python -m doombot` avisa si no esta puesto.
