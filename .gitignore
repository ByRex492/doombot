# --- Entorno virtual -------------------------------------------------------
# Nunca se versiona: contiene rutas absolutas al Python que lo creo, asi que
# un .venv del sobremesa no arranca en el portatil. Siempre se recrea.
.venv/
venv/
ENV/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Configuracion local ---------------------------------------------------
# .env lleva rutas, IPs y claves propias de cada maquina. La plantilla
# versionada es .env.example.
.env
.env.local
*.local.toml

# --- Datos generados -------------------------------------------------------
# La memoria de D.O.O.M es estado de una maquina, no codigo.
data/
*.db
*.db-journal
*.sqlite3
logs/
*.log

# --- Modelos y audio -------------------------------------------------------
# Pesan cientos de MB y se descargan solos. Fuera del repositorio.
models/
*.gguf
*.onnx
recordings/
*.wav

# --- Editor / SO -----------------------------------------------------------
# .vscode/ NO se ignora entero: settings.json y extensions.json del proyecto
# si interesan, y son agnosticos de equipo. Se excluye solo lo personal.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
Thumbs.db
desktop.ini

# --- Recuperado de la historia del sobremesa -------------------------------
# Pesos y audio que la version remota no cubria.
*.pt
*.bin
*.mp3

# --- Rust -----------------------------------------------------------------
# Los binarios compilados no se versionan: cada equipo los genera.
target/
*.pyd
*.so

# --- Vault de Obsidian -------------------------------------------------------
# El contenido (obsidian/usuario.md, obsidian/progreso/) SI se versiona: es
# lo que permite el traspaso entre equipos con git pull. Lo que no se
# versiona es la configuracion propia de la app -tema, plugins activados,
# estado de ventana-, que es de cada equipo, no del proyecto.
obsidian/.obsidian/

# --- Auxiliares del trabajo en paralelo por capas --------------------------
# Cada worktree lleva su lanzador y su encargo. Son de la sesion que trabaja
# ahi, no del proyecto: versionarlos llenaria el repo de ficheros que solo
# tienen sentido en una carpeta concreta.
/arrancar-chat.cmd
/ENCARGO.md

# launch.json del Browser pane: rutas y puertos de una previsualizacion
# puntual de una sesion concreta, no configuracion del proyecto.
.claude/
